################### {Beat} Configuration Example #########################

############################# {Beat} ######################################

routebeat:
  # Defines how often an event is sent to the output
  period: 30s

  # Tags to collect route data from
  tags:
    - "<Magnum Tag>"

  ## (optional) Nameset to select from for the "source" and "destination", value and default value for emptry route
  # mapping:
  #  nameset: "<nameset>"
  #  default: ""

  # TDA default source
  tda: ""

  # Tag for the Zorro sources.
  zorro: ""

  # Magnum API
  api:
    url: "https://<IP>/graphql/v1.1"
    
    # Get route notifications via the subscriptions
    notifications: true

    # Limit the number of destinations in the API query results
    limit: 2000

    # Serialize GraphQL polling queries across tags to reduce API load
    serialize_queries: false
    
    # Magnum OIDC Authentication
    auth:
      client_id: "<client id>"
      client_secret: "<secret key>"
      token_url: "https://<IP>/auth/realms/magnum/protocol/openid-connect/token"

    # Defines how long to wait for the API to respond before timing out
    timeout: 10s

    # Defines the idle duration after which the subscription client will be closed to test reconnect logic
    sub_reconnect_idle: 120m

  # Schedule store, rebuilt from the events api every period
  schedule:
    # how often all scheduler events are fetched (default 5m)
    period: 5m

    # each poll also fetches the events active at now+lookahead, so the upcoming windows are
    # stored before they start (default 25m)
    lookahead: 25m

    # developer settings
    #dev:
      # use the saved schedule store (scheduleStore.gob) and don't poll the events api (default false)
      #load_cache: false

      # only use schedule windows that are active now (default true)
      #validate_end_date: true

  # Scheduler events api (required). Polled for the schedule of every bus, and queried for one
  # destination when it goes unscheduled to pick up an advance or fast-forward. Requests look like:
  #   poll:    <url>?start=now&end=now&task=apg  and  <url>?start=now%2B25m&end=now%2B25m&task=apg
  #   recheck: the same two requests with &output=<bus>
  events_api:
    url: "http://127.0.0.1:8080/api/v1/scheduler/events"

    # query parameter names (defaults start, end, output, task)
    #start_param: start
    #end_param: end
    #output_param: output
    #task_param: task

    # task value sent to filter the events. empty sends no task filter (default apg)
    #task: apg

    # timeout of the per destination recheck request (default 3s)
    #timeout: 3s

    # timeout of the schedule poll requests, which return every bus (default 15s)
    #bulk_timeout: 15s

    # (optional) pause before a recheck request in case the api has latency receiving new data (default 0s, no pause)
    #delay: 0s

    # (optional) headers added to the requests
    #headers:
      #Authorization: "Bearer <token>"

  # (optional) Magnum Analytics notification programs to dispatch transition alerts
  notifiers:
    # manual notifier IP and Port settings
    manual:
      - node: "127.0.0.1"
        port: 19708

    # automatic notifier settings using the Magnum Analytics Locator API
    # default username password is admin/admin
    auto:
      host: "127.0.0.1"
      username: "admin"
      password: "admin"
      types: ["notification-elastic"]